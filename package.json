{
  "name": "tractova",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:smoke": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile",
    "test:mobile:pro": "playwright test --project=setup --project=mobile-pro",
    "test:smoke:pro": "playwright test --project=setup --project=pro-chromium",
    "test:smoke:all": "playwright test",
    "test:smoke:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint:js": "eslint \"src/**/*.{js,jsx}\"",
    "lint:api": "node scripts/lint-api.mjs",
    "lint:citations": "node scripts/lint-citations.mjs",
    "lint:secrets": "node scripts/lint-secrets.mjs",
    "lint:audit": "node scripts/audit-check.mjs",
    "lint:locs": "node scripts/lint-locs.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "check:vintages": "node scripts/check-data-vintages.mjs",
    "verify": "npm run lint:api && npm run lint:citations && npm run lint:secrets && npm run lint:audit && npm run lint:locs && npm run lint:js && npm run test:unit && npm run build && npm run test:smoke",
    "verify:full": "npm run lint:api && npm run lint:citations && npm run lint:secrets && npm run lint:audit && npm run lint:locs && npm run lint:js && npm run test:unit && npm run build && npm run test:smoke:all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-toast": "^1.2.18",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.110.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "radix-ui": "^1.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "react-simple-maps": "^3.0.0",
    "recharts": "^2.12.7",
    "shadcn": "^4.13.0",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "us-atlas": "^3.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
